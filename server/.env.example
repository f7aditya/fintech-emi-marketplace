# PostgreSQL connection string used by Prisma.
# Local docker-compose default (see docker-compose.yml at the repo root):
DATABASE_URL="postgresql://onefi:onefi@localhost:5432/onefi_marketplace?schema=public"

# Port the Express API listens on
PORT=4000

# Extra origins allowed to call the API (comma separated).
# In development ANY localhost / 127.0.0.1 / LAN origin is allowed automatically,
# so the Expo dev server (web on :8081, :8082, :19006…) works with no config.
# Set this for production, e.g. your deployed web origin, or "*" for a native-only API.
CORS_ORIGIN=""
