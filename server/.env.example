# PostgreSQL connection string used by Prisma.
# Local docker-compose default (see docker-compose.yml at the repo root):
DATABASE_URL="postgresql://onefi:onefi@localhost:5432/onefi_marketplace?schema=public"

# Port the Express API listens on
PORT=4000

# Extra origins allowed to call the API (comma separated).
# In development ANY localhost / 127.0.0.1 / LAN origin is allowed automatically,
# so the Expo dev server (web on :8081, :8082, :19006…) works with no config.
# Set this for production, e.g. your deployed web origin, or "*" for a native-only API.
CORS_ORIGIN=""

# --- Auth (optional Google sign-in) ---------------------------------------
# Secret used to sign session JWTs. Set a long random string in production.
JWT_SECRET="dev-insecure-secret-change-me"
# How long a session token stays valid (zeit/ms format).
JWT_TTL="30d"
# Comma-separated Google OAuth client IDs accepted as the ID-token "aud"
# (your Web client ID, plus the Android / iOS client IDs if you build native).
# Leave blank to disable Google verification (the dev mock still works).
GOOGLE_CLIENT_IDS=""
# Allow POST /api/auth/mock — a dev stand-in for Google sign-in.
# Always ignored when NODE_ENV=production. Set "false" to disable in dev too.
ALLOW_MOCK_AUTH="true"
